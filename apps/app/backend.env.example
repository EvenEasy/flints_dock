# Rust reads inherited environment variables. This file is not loaded automatically.
# Export settings in the shell that launches npm run desktop or the packaged binary.
# Never rename backend credentials to VITE_* or commit real keys.
DOCK_FLINTS_RPC_URL=https://api.mainnet.solana.com
DOCK_FLINTS_RPC_TIMEOUT_SECONDS=30
DOCK_FLINTS_DUST_USD=0.01
# JUPITER_API_KEY=your-rust-only-key
# DOCK_FLINTS_DAS_URL=https://your-indexer-endpoint
# DOCK_FLINTS_JOURNAL_PATH=/absolute/private/data/dock-flints/signatures.json
