{
  "name": "flints-dock-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/launch.ts dev",
    "build": "npm run typecheck && vite build",
    "preview": "node scripts/launch.ts preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop": "node scripts/launch.ts desktop",
    "desktop:build": "node scripts/launch.ts desktop:build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests scripts frontend-contract *.ts *.js package.json tsconfig.json tauri.frontend.conf.json index.html",
    "format:check": "prettier --check src tests scripts frontend-contract *.ts *.js package.json tsconfig.json tauri.frontend.conf.json index.html"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "license": "SEE LICENSE IN LICENSING.md"
}
